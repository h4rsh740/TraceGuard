# ==============================================================================
# TraceGuard Environment Configuration
# NOTE: DO NOT COMMIT REAL SECRETS TO VERSION CONTROL.
# If a secret is ever pushed to GitHub, revoke and regenerate it immediately.
# Deleting it from git history is NOT enough.
# ==============================================================================

# PayPal Sandbox Credentials (SANDBOX ONLY - TraceGuard strictly refuses live URLs)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# LLM Configuration (Provider-agnostic)
# Supported providers: openai | anthropic | gemini
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# Database Configuration (PostgreSQL)
# For local Docker: postgresql+psycopg2://traceguard:traceguard@postgres:5432/traceguard_db
# For local standalone: postgresql+psycopg2://traceguard:traceguard@localhost:5432/traceguard_db
DATABASE_URL=postgresql+psycopg2://traceguard:traceguard@localhost:5432/traceguard_db

# Webhook & Host Configuration
# PUBLIC_BASE_URL is the public tunnel or deployed domain where PayPal sends webhooks (e.g. https://xxx.ngrok-free.app)
PUBLIC_BASE_URL=
# FRONTEND_ORIGIN is used for CORS restrictions (e.g. http://localhost:3000)
FRONTEND_ORIGIN=http://localhost:3000

# Security & Dashboard Admin Auth
ADMIN_PASSWORD=
