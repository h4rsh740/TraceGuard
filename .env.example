# ==============================================================================
# TraceGuard Environment Configuration
# Default dummy credentials provided for immediate out-of-the-box local testing.
# ==============================================================================

# PayPal Sandbox Credentials (SANDBOX ONLY - TraceGuard strictly refuses live production URLs)
PAYPAL_CLIENT_ID=dummy_sandbox_client_id_paypal
PAYPAL_CLIENT_SECRET=dummy_sandbox_secret_paypal
PAYPAL_WEBHOOK_ID=dummy_webhook_id_paypal
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# LLM Configuration (Provider-agnostic: mock | gemini | openai | anthropic)
# Default 'mock' runs offline deterministic zero-cost investigations.
LLM_PROVIDER=mock
LLM_MODEL=mock-investigator-v1
LLM_API_KEY=mock_key_dummy_123

# Database Configuration (PostgreSQL)
# For local Docker: postgresql+psycopg2://traceguard:traceguard@postgres:5432/traceguard_db
# For local standalone: postgresql+psycopg2://traceguard:traceguard@localhost:5432/traceguard_db
DATABASE_URL=postgresql+psycopg2://traceguard:traceguard@localhost:5432/traceguard_db

# Webhook & Host Configuration
# PUBLIC_BASE_URL is the public tunnel or deployed domain where PayPal sends webhooks (e.g. https://xxx.ngrok-free.app)
PUBLIC_BASE_URL=http://localhost:8000
# FRONTEND_ORIGIN is used for CORS restrictions (e.g. http://localhost:3000)
FRONTEND_ORIGIN=http://localhost:3000

# Security & Dashboard Admin Auth
ADMIN_PASSWORD=traceguard_admin_secret
